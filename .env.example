# CIWS reads provider keys from the environment first, then from its encrypted
# vault. Copy this to .env, fill in what you have, and leave the rest blank --
# the hub runs with none of them, using local models and local embeddings.

# --- Language models ------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=

# --- Image and video ------------------------------------------------------
REPLICATE_API_TOKEN=
FAL_KEY=
STABILITY_API_KEY=

# --- Web search (any one is enough; DuckDuckGo works with none) -----------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# --- Connectors -----------------------------------------------------------
GITHUB_TOKEN=

# --- Local runtimes -------------------------------------------------------
CIWS_OLLAMA_URL=http://127.0.0.1:11434
CIWS_LMSTUDIO_URL=http://127.0.0.1:1234/v1

# --- Hub itself -----------------------------------------------------------
# CIWS_HOME=~/.ciws
# CIWS_PORT=8787
# CIWS_HOST=127.0.0.1
